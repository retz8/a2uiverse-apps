{
  "name": "gmail-catalog",
  "version": "0.2.0",
  "description": "The Gmail app catalog for A2UIVerse: the A2UI basic catalog under a Material 3 product theme, as schema + implementation + Provider. The host supplies React, the A2UI runtime, and zod.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retz8/a2uiverse-apps.git",
    "directory": "gmail/gmail-catalog"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./id": {
      "import": {
        "types": "./dist/catalog-id.d.ts",
        "default": "./dist/catalog-id.js"
      }
    }
  },
  "files": [
    "dist",
    "catalogs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-theme.mjs",
    "prepare": "tsc -p tsconfig.json && node scripts/copy-theme.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@a2ui/react": "^0.10.1",
    "@a2ui/web_core": "^0.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "zod": "^3.25.76"
  }
}
