{
  "name": "gmail-catalog",
  "version": "0.3.0",
  "description": "The Gmail app catalog for A2UIVerse: Gmail's own Material 3 components as schema + implementation + Provider, with its tokens, its stylesheet and Google Sans. The host supplies React, the A2UI runtime, and zod.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retz8/a2uiverse-apps.git",
    "directory": "gmail/gmail-catalog"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./id": {
      "import": {
        "types": "./dist/catalog-id.d.ts",
        "default": "./dist/catalog-id.js"
      }
    }
  },
  "files": [
    "dist",
    "catalogs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepare": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "stellify check",
    "tokens": "node scripts/generate-tokens.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "peerDependencies": {
    "@a2ui/react": "^0.10.1",
    "@a2ui/web_core": "^0.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.1",
    "@a2uiverse/stellify": "github:retz8/a2uiverse#e815b919b525afb496b9f7b7b105649a13b50c25&path:packages/stellify",
    "@material/material-color-utilities": "0.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "zod": "^3.25.76"
  }
}
