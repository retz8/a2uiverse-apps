{
  "name": "label-toggle",
  "intent": "Show me my labels so I can file the receipts.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "labels",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/gmail/gmail-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "labels",
        "path": "/",
        "value": {
          "labels": [
            {
              "id": "Label_12",
              "name": "Receipts"
            },
            {
              "id": "Label_19",
              "name": "Travel"
            },
            {
              "id": "Label_23",
              "name": "Reading"
            }
          ]
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "labels",
        "components": [
          {
            "id": "root",
            "component": "Surface",
            "child": "body",
            "container": "low",
            "shape": "large",
            "padding": "small"
          },
          {
            "id": "body",
            "component": "Stack",
            "children": [
              "header",
              "label-list"
            ],
            "gap": "xs"
          },
          {
            "id": "header",
            "component": "Stack",
            "children": [
              "heading",
              "sub"
            ],
            "gap": "xs",
            "padding": "sm"
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "Your labels",
            "variant": "titleLarge"
          },
          {
            "id": "sub",
            "component": "Text",
            "text": "Applies to the thread you have open",
            "variant": "bodySmall",
            "color": "onSurfaceVariant"
          },
          {
            "id": "label-list",
            "component": "Stack",
            "children": {
              "path": "/labels",
              "componentId": "label-row"
            },
            "gap": "none"
          },
          {
            "id": "label-row",
            "component": "NavigationItem",
            "label": {
              "path": "name"
            },
            "icon": "label",
            "action": {
              "event": {
                "name": "label-toggle",
                "context": {
                  "labelId": {
                    "path": "id"
                  },
                  "add": true
                }
              }
            }
          }
        ]
      }
    }
  ]
}
