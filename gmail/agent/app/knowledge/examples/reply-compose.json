{
  "name": "reply-compose",
  "intent": "Draft a reply confirming Thursday works.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "draft-th-1",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/gmail/gmail-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "draft-th-1",
        "path": "/",
        "value": {
          "to": "Alex Bergman",
          "subject": "Re: Revised timeline for the review",
          "body": "Thursday still works on my end — I will have the estimates ready before the review. Thanks for moving it."
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "draft-th-1",
        "components": [
          {
            "id": "root",
            "component": "Surface",
            "child": "body",
            "container": "lowest",
            "shape": "large",
            "padding": "none",
            "elevation": "level2"
          },
          {
            "id": "body",
            "component": "Stack",
            "children": [
              "title-bar",
              "fields",
              "actions"
            ],
            "gap": "none"
          },
          {
            "id": "title-bar",
            "component": "Surface",
            "child": "heading",
            "container": "high",
            "shape": "none",
            "padding": "medium"
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "Save this reply?",
            "variant": "titleSmall"
          },
          {
            "id": "fields",
            "component": "Stack",
            "children": [
              "to-field",
              "subject-field",
              "body-field"
            ],
            "gap": "none",
            "padding": "md"
          },
          {
            "id": "to-field",
            "component": "TextField",
            "label": "To",
            "value": {
              "path": "/to"
            },
            "variant": "plain"
          },
          {
            "id": "subject-field",
            "component": "TextField",
            "label": "Subject",
            "value": {
              "path": "/subject"
            },
            "variant": "plain"
          },
          {
            "id": "body-field",
            "component": "TextField",
            "label": "Message",
            "value": {
              "path": "/body"
            },
            "variant": "plain",
            "multiline": true
          },
          {
            "id": "actions",
            "component": "Stack",
            "children": [
              "save",
              "cancel"
            ],
            "direction": "horizontal",
            "gap": "sm",
            "padding": "md"
          },
          {
            "id": "save",
            "component": "Button",
            "label": "Save draft",
            "icon": "draft",
            "action": {
              "event": {
                "name": "confirm-draft",
                "context": {
                  "threadId": "th-1"
                }
              }
            }
          },
          {
            "id": "cancel",
            "component": "Button",
            "label": "Discard",
            "variant": "text",
            "action": {
              "event": {
                "name": "cancel-draft",
                "context": {
                  "threadId": "th-1"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
