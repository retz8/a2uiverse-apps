            "align": "center",
            "children": [
              "header-left",
              "header-right"
            ]
          },
          {
            "id": "header-left",
            "component": "Stack",
            "direction": "horizontal",
            "gap": "condensed",
            "align": "center",
            "children": [
              "repo-icon",
              "repo-link",
              "slash-text",
              "title",
              "count-label"
            ]
          },
          {
            "id": "repo-icon",
            "component": "Icon",
            "name": "repo",
            "fill": "muted",
            "accessibility": {
              "label": "Repository"
            }
          },
          {
            "id": "repo-link",
            "component": "Link",
            "text": "a2ui-project/a2ui",
            "href": "https://github.com/a2ui-project/a2ui"
          },
          {
            "id": "slash-text",
            "component": "Text",
            "text": "/"
          },
          {
            "id": "title",
            "component": "Heading",
            "text": "Pull Requests",
            "as": "h1",
            "variant": "small"
          },
          {
            "id": "count-label",
            "component": "CounterLabel",
            "count": 56,
            "variant": "primary"
          },
          {
            "id": "header-right",
            "component": "Label",
            "text": "Needs Review",
            "variant": "attention"
          },
          {
            "id": "description",
            "component": "Text",
            "text": "Showing the most recent open pull requests needing review. Total: 56.",
            "size": "small",
            "weight": "normal"
          },
          {
            "id": "list",
            "component": "ActionList",
            "role": "listbox",
            "showDividers": true,
            "children": {
              "componentId": "pr-row",
              "path": "/prs"
            }
          },
          {
            "id": "pr-row",
            "component": "ActionList.Item",
            "children": [
              "row-lv",
              "row-title",
              "row-desc",
              "row-tv"
            ],
            "action": {
              "event": {
                "name": "open-pull-request",
                "context": {
                  "repository": {
                    "path": "repository"
                  },
                  "number": {
                    "path": "number"
                  }
                }
              }
            }
          },
          {
            "id": "row-lv",
            "component": "ActionList.LeadingVisual",
            "children": [
              "row-icon"
            ]
          },
          {
            "id": "row-icon",
            "component": "Icon",
            "name": "git-pull-request",
            "fill": "open",
            "accessibility": {
              "label": "Open Pull Request"
            }
          },
          {
            "id": "row-title",
            "component": "Text",
            "text": {
              "path": "title"
            },
            "weight": "semibold"
          },
          {
            "id": "row-desc",
            "component": "ActionList.Description",
            "text": {
              "path": "meta"
            },
            "variant": "block"
          },
          {
            "id": "row-tv",
            "component": "ActionList.TrailingVisual",
            "children": [
              "row-time"
            ]
          },
          {
            "id": "row-time",
            "component": "RelativeTime",
            "datetime": {
              "path": "updatedAt"
            },
            "format": "relative"
          }
        ]
      }
    },
