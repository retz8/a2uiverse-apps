# Live agent configuration. Copy to agent/.env and fill in.

# Gemini model (ADK-native). gemini-3.5-flash works as a cheaper fallback; when
# a defect looks like a model ceiling rather than a prompt problem, swap up to
# gemini-3.1-pro-preview through this same knob.
#
# Do not drop to a lite tier. Observed below the floor twice independently: one
# scenario produced no surface at all (both attempts dying on the same malformed
# bracket), and another made a single tool call, fetched nothing it needed,
# emitted zero affordances, and invented the repository description outright.
MODEL_NAME=gemini-3.7-flash

# Google AI Studio API key — ADK reads this to auth Gemini.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# GitHub PAT for the remote GitHub MCP server. THE AGENT ACTS AS THIS TOKEN'S
# USER: it holds the server's full tool surface, writes included, and can do
# exactly what the token allows — comments, issues, reviews, merges land under
# your name on any repository the token reaches (task-3.7 decision 1). Scope the
# token to the authority you want the agent to have; content-bearing writes are
# proposed on the canvas and fire only on your confirmation.
GITHUB_MCP_PAT=your-github-pat

