{
  "name": "github-catalog",
  "version": "0.1.0",
  "description": "The GitHub app catalog for A2UIVerse: the A2UI catalog schema and its Primer React implementation, with the Provider that scopes Primer to the fragment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retz8/a2uiverse-apps.git",
    "directory": "github/github-catalog"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "catalogs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@primer/primitives": "^11.9.0"
  },
  "peerDependencies": {
    "@a2ui/react": "^0.10.1",
    "@a2ui/web_core": "^0.10.1",
    "@primer/octicons-react": "^19.28.1",
    "@primer/react": "^38.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.1",
    "@preact/signals-core": "^1.14.2",
    "@primer/octicons-react": "19.28.1",
    "@primer/react": "^38.28.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "zod": "^3.25.76"
  }
}
