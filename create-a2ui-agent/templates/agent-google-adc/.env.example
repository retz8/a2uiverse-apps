# Live and stub agent configuration. Copy to agent/.env and fill in.

# Gemini model (ADK-native). Override per run; the kit's default is gemini-3.7-flash.
MODEL_NAME=gemini-3.7-flash

# Google AI Studio API key — ADK reads this to auth Gemini. Needed by --mode stub and --mode live.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The GCP project billed for the MCP calls, sent as the X-Goog-User-Project header.
GOOGLE_CLOUD_PROJECT=your-gcp-project

# NOTE: there is no __DISPLAY_NAME__ token here, deliberately. The agent reads Application
# Default Credentials and lets the library refresh them, so it never holds a secret and never
# expires mid-run. Mint them once — see README.md, "Setting up the credential".
