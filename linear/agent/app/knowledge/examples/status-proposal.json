{
  "name": "status-proposal",
  "intent": "Move ENG-230 to In Progress",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "status-proposal",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/linear/linear-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "status-proposal",
        "path": "/",
        "value": {
          "team": "Engineering",
          "id": "ENG-230",
          "title": "Empty state for the archive view",
          "from": "Todo",
          "fromType": "unstarted",
          "to": "In Progress",
          "toType": "started"
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "status-proposal",
        "components": [
          {
            "id": "root",
            "component": "Panel",
            "padding": "none",
            "child": "body"
          },
          {
            "id": "body",
            "component": "Stack",
            "gap": "none",
            "children": [
              "header",
              "content"
            ]
          },
          {
            "id": "header",
            "component": "ViewHeader",
            "context": {
              "path": "/team"
            },
            "title": {
              "path": "/id"
            }
          },
          {
            "id": "content",
            "component": "Stack",
            "padding": "l",
            "gap": "m",
            "children": [
              "question",
              "issue-title",
              "change",
              "actions"
            ]
          },
          {
            "id": "question",
            "component": "Text",
            "text": "Change this issue's status?",
            "variant": "title"
          },
          {
            "id": "issue-title",
            "component": "Text",
            "text": {
              "path": "/title"
            },
            "weight": "medium"
          },
          {
            "id": "change",
            "component": "Property",
            "label": "Status",
            "children": [
              "from-icon",
              "from-name",
              "arrow",
              "to-icon",
              "to-name"
            ]
          },
          {
            "id": "from-icon",
            "component": "StatusIcon",
            "status": {
              "path": "/from"
            },
            "type": {
              "path": "/fromType"
            }
          },
          {
            "id": "from-name",
            "component": "Text",
            "text": {
              "path": "/from"
            }
          },
          {
            "id": "arrow",
            "component": "Icon",
            "name": "arrow-right"
          },
          {
            "id": "to-icon",
            "component": "StatusIcon",
            "status": {
              "path": "/to"
            },
            "type": {
              "path": "/toType"
            }
          },
          {
            "id": "to-name",
            "component": "Text",
            "text": {
              "path": "/to"
            }
          },
          {
            "id": "actions",
            "component": "Stack",
            "direction": "horizontal",
            "gap": "s",
            "children": [
              "confirm",
              "decline"
            ]
          },
          {
            "id": "confirm",
            "component": "Button",
            "variant": "primary",
            "label": "Move to In Progress",
            "action": {
              "event": {
                "name": "confirm-change",
                "context": {
                  "issueId": {
                    "path": "/id"
                  },
                  "state": {
                    "path": "/to"
                  }
                }
              }
            }
          },
          {
            "id": "decline",
            "component": "Button",
            "variant": "ghost",
            "label": "Keep as is",
            "action": {
              "event": {
                "name": "decline-change",
                "context": {
                  "issueId": {
                    "path": "/id"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
