      "updateDataModel": {
        "surfaceId": "issue-detail",
        "path": "/",
        "value": {
          "id": "ENG-212",
          "title": "Retry webhook deliveries with exponential backoff",
          "status": "In Progress",
          "statusType": "started",
          "priority": "High",
          "assignee": "Mira Kovač",
          "labels": "Improvement",
          "description": "Failed deliveries are retried once, immediately. Retry up to five times with exponential backoff and jitter, and surface the final failure on the endpoint's page.",
          "pullRequests": [
            {
              "title": "Back off webhook retries exponentially",
              "number": "#481"
            }
          ],
          "branch": "mira/eng-212-retry-webhook-deliveries-with-exponential-backoff",
          "comments": [
            {
              "author": "dev-okafor",
              "when": "Sep 15",
              "body": "Cap the delay at five minutes, or a dead endpoint holds the queue for hours."
            },
            {
              "author": "Mira Kovač",
              "when": "Sep 16",
              "body": "Capped at five minutes; jitter is ±20%."
            }
          ]
        }
      }
    },
