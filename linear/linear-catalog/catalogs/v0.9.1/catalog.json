{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retz8/a2uiverse-apps/blob/main/linear/linear-catalog/catalogs/v0.9.1/catalog.json",
  "title": "Linear Catalog",
  "description": "The Linear app catalog: Linear's component vocabulary in its design language — panels, lists of rows grouped by state, properties, chips, the status and priority glyphs — with the basic catalog's functions.",
  "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/linear/linear-catalog/catalogs/v0.9.1/catalog.json",
  "components": {
    "Panel": {
      "type": "object",
      "description": "A view's surface: a bordered, rounded panel one step above the page, holding one child. Each view is one Panel; never nest one Panel in another.",
      "properties": {
        "component": {
          "const": "Panel"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The panel's content, usually a Stack."
        },
        "padding": {
          "type": "string",
          "enum": ["none", "normal"],
          "default": "normal",
          "description": "Space inside the panel's border. `none` lets a ViewHeader or a List run to the border."
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Stack": {
      "type": "object",
      "description": "A flex container laying its children out in a column or a row. The default container inside a panel.",
      "properties": {
        "component": {
          "const": "Stack"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The components arranged inside the stack."
        },
        "direction": {
          "type": "string",
          "enum": ["vertical", "horizontal"],
          "default": "vertical",
          "description": "The axis the children run along."
        },
        "gap": {
          "type": "string",
          "enum": ["none", "xs", "s", "m", "l", "xl"],
          "default": "s",
          "description": "The space between children."
        },
        "align": {
          "type": "string",
          "enum": ["stretch", "start", "center", "end", "baseline"],
          "default": "stretch",
          "description": "How children sit on the cross axis."
        },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "space-between"],
          "default": "start",
          "description": "How children are distributed along the axis."
        },
        "wrap": {
          "type": "boolean",
          "default": false,
          "description": "Whether a row wraps onto further lines when it runs out of width."
        },
        "padding": {
          "type": "string",
          "enum": ["none", "s", "m", "l"],
          "default": "none",
          "description": "Space inside the stack's edges, for content set in from a full-width header."
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "A hairline between two sections. It separates; it does not decorate.",
      "properties": {
        "component": {
          "const": "Divider"
        }
      },
      "required": ["component"],
      "unevaluatedProperties": false
    },
    "ViewHeader": {
      "type": "object",
      "description": "A view's header bar, one line at the top of a panel: an optional context, a separator, then the title — a team and an issue's identifier, or a list and what it shows.",
      "properties": {
        "component": {
          "const": "ViewHeader"
        },
        "title": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "What the view is: an issue's identifier, a list's name."
        },
        "context": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "Where the view sits: a team, a view it belongs to. Shown before the title."
        },
        "trailing": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "Components at the far end of the bar."
        }
      },
      "required": ["component", "title"],
      "unevaluatedProperties": false
    },
    "Section": {
      "type": "object",
      "description": "A titled block of a view, such as its links or its activity, with an optional count beside the title.",
      "properties": {
        "component": {
          "const": "Section"
        },
        "title": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The section's title."
        },
        "count": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "A count shown beside the title, such as how many links."
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The section's content."
        }
      },
      "required": ["component", "title", "children"],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "description": "A run of plain text in one of the type registers. Markdown is shown as written; use Markdown for text written in it.",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The text to display."
        },
        "variant": {
          "type": "string",
          "enum": ["title", "heading", "body", "secondary", "caption"],
          "default": "body",
          "description": "The type register: `title` for the view's one title, `heading` for a heading inside it, `body` for ordinary text, `secondary` for quieter body text such as identifiers, `caption` for the smallest text such as times and field labels."
        },
        "weight": {
          "type": "string",
          "enum": ["normal", "medium", "semibold"],
          "description": "Font weight, for a name or a row's title."
        },
        "truncate": {
          "type": "boolean",
          "default": false,
          "description": "Keep the text to one line, ending it with an ellipsis when it does not fit."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    },
    "Markdown": {
      "type": "object",
      "description": "Text written in Markdown, such as a description or a comment, rendered with its formatting. HTML is shown as text, a link as its text, an image as its alt text.",
      "properties": {
        "component": {
          "const": "Markdown"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The Markdown source, as written."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "description": "A labelled button that performs an action. `primary` is the one action a view leads with; `secondary` is any other; `ghost` is the quiet way out.",
      "properties": {
        "component": {
          "const": "Button"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The button's label: the outcome of pressing it."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the button is pressed."
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "ghost"],
          "default": "secondary",
          "description": "The button's emphasis."
        },
        "leading": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "A glyph shown before the label."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the button is disabled and cannot be pressed."
        }
      },
      "required": ["component", "label", "action"],
      "unevaluatedProperties": false
    },
    "List": {
      "type": "object",
      "description": "A dense list of rows, one line each, with hairlines between them. Its children are ListItems, or ListGroups of them.",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The list's ListItems or ListGroups; a template over an array gives one row per element."
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "ListGroup": {
      "type": "object",
      "description": "A group of rows inside a List, headed by its label, an optional leading glyph and a count — one group per workflow state, for example.",
      "properties": {
        "component": {
          "const": "ListGroup"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The group's label, such as a state's name."
        },
        "count": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "How many rows the group holds."
        },
        "leading": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "A glyph before the label, such as the state's StatusIcon."
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The group's ListItems."
        }
      },
      "required": ["component", "label", "children"],
      "unevaluatedProperties": false
    },
    "ListItem": {
      "type": "object",
      "description": "One row of a List or a ListGroup: its leading glyphs and identifiers, its content taking the remaining width on one line, and its trailing meta at the far end. With an action the whole row is pressable, so a row with an action holds no Button.",
      "properties": {
        "component": {
          "const": "ListItem"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The row's content, usually its title as a Text."
        },
        "leading": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "Glyphs and short text before the content, in order."
        },
        "trailing": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "Secondary meta after the content, such as chips and a time."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the row is pressed."
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Property": {
      "type": "object",
      "description": "A labelled property of an item, such as its status or its assignee: the label, and the value's parts beside it.",
      "properties": {
        "component": {
          "const": "Property"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The property's name."
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The value's parts in a row: a glyph and a name, an avatar and a name, chips."
        }
      },
      "required": ["component", "label", "children"],
      "unevaluatedProperties": false
    },
    "Chip": {
      "type": "object",
      "description": "A small rounded chip naming one thing, such as a label: its name, and before it a colour dot or a leading glyph.",
      "properties": {
        "component": {
          "const": "Chip"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The chip's text."
        },
        "color": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The thing's own colour from the data, as `#rrggbb`, drawn as a dot. Anything but a hex colour draws no dot."
        },
        "leading": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "A glyph drawn instead of the dot, such as a StatusIcon."
        }
      },
      "required": ["component", "label"],
      "unevaluatedProperties": false
    },
    "Avatar": {
      "type": "object",
      "description": "A person, drawn as their initials in a circle, labelled with their full name.",
      "properties": {
        "component": {
          "const": "Avatar"
        },
        "name": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The person's name."
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium"],
          "default": "small",
          "description": "The avatar's size."
        }
      },
      "required": ["component", "name"],
      "unevaluatedProperties": false
    },
    "Icon": {
      "type": "object",
      "description": "A small system glyph: `arrow-right` between a value and what it changes to, `branch`, `pull-request`, `link`, `plus`, `check`. Decorative unless it carries a label.",
      "properties": {
        "component": {
          "const": "Icon"
        },
        "name": {
          "type": "string",
          "enum": ["arrow-right", "branch", "pull-request", "link", "plus", "check"],
          "description": "Which glyph to draw."
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "What the glyph means, for assistive technology."
        }
      },
      "required": ["component", "name"],
      "unevaluatedProperties": false
    },
    "StatusIcon": {
      "type": "object",
      "description": "A workflow state's glyph, drawn from the state's type and labelled with its name. Bind both per row in a list.",
      "properties": {
        "component": {
          "const": "StatusIcon"
        },
        "status": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The state's name as the team calls it, such as In Review; the glyph's label."
        },
        "type": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The state's type as the data carries it: backlog, unstarted, started, completed, canceled, duplicate or triage. It decides the drawing."
        }
      },
      "required": ["component", "status", "type"],
      "unevaluatedProperties": false
    },
    "PriorityIcon": {
      "type": "object",
      "description": "A priority's glyph: bars rising with the priority, a mark for urgent, dashes for none. Labelled with the priority's name. Bind it per row in a list.",
      "properties": {
        "component": {
          "const": "PriorityIcon"
        },
        "priority": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The priority's name as the data carries it — Urgent, High, Medium, Low or No priority — or its number, 0 to 4."
        }
      },
      "required": ["component", "priority"],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "Checks that the value is not null, undefined, or empty.",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "The value to check."
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regex": {
      "type": "object",
      "description": "Checks that the value matches a regular expression string.",
      "properties": {
        "call": {
          "const": "regex"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            },
            "pattern": {
              "type": "string",
              "description": "The regex pattern to match against."
            }
          },
          "required": ["value", "pattern"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "length": {
      "type": "object",
      "description": "Checks string length constraints.",
      "properties": {
        "call": {
          "const": "length"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "The minimum allowed length."
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "description": "The maximum allowed length."
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "numeric": {
      "type": "object",
      "description": "Checks numeric range constraints.",
      "properties": {
        "call": {
          "const": "numeric"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber"
            },
            "min": {
              "type": "number",
              "description": "The minimum allowed value."
            },
            "max": {
              "type": "number",
              "description": "The maximum allowed value."
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "email": {
      "type": "object",
      "description": "Checks that the value is a valid email address.",
      "properties": {
        "call": {
          "const": "email"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatString": {
      "type": "object",
      "description": "Performs string interpolation of data model values and other functions in the catalog functions list and returns the resulting string. The value string can contain interpolated expressions in the `${expression}` format. Supported expression types include: JSON Pointer paths to the data model (e.g., `${/absolute/path}` or `${relative/path}`), and client-side function calls (e.g., `${now()}`). Function arguments must be named (e.g., `${formatDate(value:${/currentDate}, format:'MM-dd')}`). To include a literal `${` sequence, escape it as `\\${`.",
      "properties": {
        "call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatNumber": {
      "type": "object",
      "description": "Formats a number with the specified grouping and decimal precision.",
      "properties": {
        "call": {
          "const": "formatNumber"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "The number to format."
            },
            "decimals": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatCurrency": {
      "type": "object",
      "description": "Formats a number as a currency string.",
      "properties": {
        "call": {
          "const": "formatCurrency"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "The monetary amount."
            },
            "currency": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The ISO 4217 currency code (e.g., 'USD', 'EUR')."
            },
            "decimals": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["currency", "value"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatDate": {
      "type": "object",
      "description": "Formats a timestamp into a string using a pattern.",
      "properties": {
        "call": {
          "const": "formatDate"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "The date to format."
            },
            "format": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "A Unicode TR35 date pattern string.\n\nToken Reference:\n- Year: 'yy' (26), 'yyyy' (2026)\n- Month: 'M' (1), 'MM' (01), 'MMM' (Jan), 'MMMM' (January)\n- Day: 'd' (1), 'dd' (01), 'E' (Tue), 'EEEE' (Tuesday)\n- Hour (12h): 'h' (1-12), 'hh' (01-12) - requires 'a' for AM/PM\n- Hour (24h): 'H' (0-23), 'HH' (00-23) - Military Time\n- Minute: 'mm' (00-59)\n- Second: 'ss' (00-59)\n- Period: 'a' (AM/PM)\n\nExamples:\n- 'MMM dd, yyyy' -> 'Jan 16, 2026'\n- 'HH:mm' -> '14:30' (Military)\n- 'h:mm a' -> '2:30 PM'\n- 'EEEE, d MMMM' -> 'Friday, 16 January'"
            }
          },
          "required": ["format", "value"],
          "unevaluatedProperties": false
        },
        "returnType": {
