# Live and stub agent configuration. Copy to agent/.env and fill in.

# Gemini model (ADK-native). Override per run; the kit's default is gemini-3.7-flash.
MODEL_NAME=gemini-3.7-flash

# Google AI Studio API key — ADK reads this to auth Gemini. Needed by --mode stub and --mode live.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The CircleCI personal API token the live agent sends to CircleCI's hosted MCP server as a
# bearer token (see app/mcp.py). Create it under User settings → Personal API Tokens. It carries
# no scopes: the agent can do whatever this token's user can.
# Deliberately not CIRCLE_TOKEN: the CircleCI CLI reads that name implicitly, so a stray value
# could silently shadow this one.
CIRCLECI_MCP_TOKEN=

# The CircleCI projects this agent covers, comma-separated, each `repository-name=project-id`.
# The id is the project's UUID (CircleCI project settings); a project created through
# CircleCI's GitHub App is not found by its gh/<org>/<repo> slug.
CIRCLECI_PROJECTS=
