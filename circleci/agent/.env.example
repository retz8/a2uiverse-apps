# Live and stub agent configuration. Copy to agent/.env and fill in.

# The model. Override per run; the kit's default is gemini-3.8-flash. A Claude model is named
# anthropic/<model> and reads ANTHROPIC_API_KEY instead of the Google key below, with the
# limits the kit README lists.
MODEL_NAME=gemini-3.8-flash

# The thinking tier: low, the kit's default, the least thinking the provider offers;
# default leaves the model's own.
# MODEL_EFFORT=low

# Google AI Studio API key — ADK reads this to auth Gemini. Needed by --mode stub and --mode live.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# There is no CircleCI token or project list here: the agent signs in to CircleCI through
# A2UIVerse and lists the projects you follow (see README.md, "Signing in").
