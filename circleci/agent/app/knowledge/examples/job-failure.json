{
  "name": "job-failure",
  "intent": "Why did the build fail?",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "job-failure",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/circleci/circleci-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "job-failure",
        "path": "/",
        "value": {
          "job": {
            "id": "job-1",
            "name": "unit-tests",
            "workflowId": "wf-1"
          },
          "step": {
            "name": "Run the test suite",
            "exitCode": "Exited with code 1"
          },
          "lines": [
            {
              "text": "FAIL src/checkout/payment.test.ts > renders the payment step first"
            },
            {
              "text": "AssertionError: expected 'address' to be 'payment'"
            },
            {
              "text": "Test Files  1 failed | 41 passed (42)"
            },
            {
              "text": "Tests  1 failed | 318 passed (319)"
            }
          ]
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "job-failure",
        "components": [
          {
            "id": "root",
            "component": "Panel",
            "child": "body"
          },
          {
            "id": "body",
            "component": "Stack",
            "gap": "medium",
            "children": [
              "heading",
              "step",
              "actions"
            ]
          },
          {
            "id": "heading",
            "component": "Heading",
            "text": {
              "path": "/job/name"
            },
            "size": "large"
          },
          {
            "id": "step",
            "component": "Panel",
            "tone": "danger",
            "padding": "small",
            "child": "step-body"
          },
          {
            "id": "step-body",
            "component": "Stack",
            "children": [
              "step-top",
              "log"
            ]
          },
          {
            "id": "step-top",
            "component": "Stack",
            "direction": "horizontal",
            "children": [
              "step-lead",
              "step-exit"
            ],
            "align": "center",
            "justify": "spaceBetween"
          },
          {
            "id": "step-lead",
            "component": "Stack",
            "direction": "horizontal",
            "children": [
              "step-status",
              "step-name"
            ],
            "align": "center"
          },
          {
            "id": "step-status",
            "component": "StatusIcon",
            "status": "Failed",
            "size": "small"
          },
          {
            "id": "step-name",
            "component": "Text",
            "text": {
              "path": "/step/name"
            },
            "weight": "medium"
          },
          {
            "id": "step-exit",
            "component": "Text",
            "text": {
              "path": "/step/exitCode"
            },
            "tone": "muted",
            "size": "small"
          },
          {
            "id": "log",
            "component": "LogBlock",
            "children": {
              "path": "/lines",
              "componentId": "log-line"
            }
          },
          {
            "id": "log-line",
            "component": "LogLine",
            "text": {
              "path": "text"
            }
          },
          {
            "id": "actions",
            "component": "Stack",
            "direction": "horizontal",
            "children": [
              "rerun-failed"
            ]
          },
          {
            "id": "rerun-failed",
            "component": "Button",
            "label": "Rerun from failed",
            "action": {
              "event": {
                "name": "rerun-workflow",
                "context": {
                  "workflowId": {
                    "path": "/job/workflowId"
                  },
                  "fromFailed": true
                }
              }
            }
          }
        ]
      }
    }
  ]
}
