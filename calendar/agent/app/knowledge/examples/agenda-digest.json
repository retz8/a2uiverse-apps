          {
            "id": "clash-swatch",
            "component": "ColorSwatch",
            "color": "peacock",
            "shape": "dot"
          },
          {
            "id": "clash-when",
            "component": "Text",
            "text": {
              "path": "when"
            },
            "variant": "labelLarge"
          },
          {
            "id": "clash-body",
            "component": "Stack",
            "children": [
              "clash-summary",
              "clash-note"
            ],
            "gap": "none"
          },
          {
            "id": "clash-summary",
            "component": "Text",
            "text": {
              "path": "summary"
            },
            "maxLines": 1
          },
          {
            "id": "clash-note",
            "component": "Text",
            "text": {
              "path": "note"
            },
            "variant": "bodySmall",
            "color": "onSurfaceVariant",
            "maxLines": 1
          }
        ]
