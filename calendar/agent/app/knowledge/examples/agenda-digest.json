{
  "name": "agenda-digest",
  "intent": "What needs my attention today?",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "needs-attention",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/calendar/calendar-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "needs-attention",
        "path": "/",
        "value": {
          "waiting": [
            {
              "id": "ev-2",
              "when": "11:00",
              "summary": "Design review — agenda surface",
              "note": "Invitation unanswered"
            },
            {
              "id": "ev-6",
              "when": "Tomorrow 10:00",
              "summary": "Quarter planning",
              "note": "Invitation unanswered"
            }
          ],
          "clashes": [
            {
              "id": "ev-2",
              "when": "11:00 – 12:00",
              "summary": "Design review — agenda surface",
              "note": "Overlaps Budget sync"
            },
            {
              "id": "ev-3",
              "when": "11:30 – 12:15",
              "summary": "Budget sync",
              "note": "Overlaps Design review"
            }
          ]
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "needs-attention",
        "components": [
          {
            "id": "root",
            "component": "Surface",
            "child": "body",
            "container": "low",
            "shape": "large",
            "padding": "small"
          },
          {
            "id": "body",
            "component": "Stack",
            "children": [
              "header",
              "sheet"
            ],
            "gap": "xs"
          },
          {
            "id": "header",
            "component": "Stack",
            "children": [
              "heading"
            ],
            "padding": "sm"
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "Needs attention today",
            "variant": "titleLarge"
          },
          {
            "id": "sheet",
            "component": "Surface",
            "child": "sections",
            "container": "lowest",
            "shape": "large",
            "padding": "none"
          },
          {
            "id": "sections",
            "component": "Stack",
            "children": [
              "waiting-label",
              "waiting-list",
              "divider",
              "clash-label",
              "clash-list"
            ],
            "gap": "none"
          },
          {
            "id": "waiting-label",
            "component": "Stack",
            "children": [
              "waiting-title"
            ],
            "padding": "sm"
          },
          {
            "id": "waiting-title",
            "component": "Text",
            "text": "Unanswered invitations",
            "variant": "titleSmall",
            "color": "primary"
          },
          {
            "id": "waiting-list",
            "component": "List",
            "children": {
              "path": "/waiting",
              "componentId": "waiting-row"
            },
            "layout": "inline"
          },
          {
            "id": "waiting-row",
            "component": "ListItem",
            "headline": "waiting-when",
            "supporting": "waiting-body",
            "leading": [
              "waiting-swatch"
            ],
            "action": {
              "event": {
                "name": "open-event",
                "context": {
                  "eventId": {
                    "path": "id"
                  }
                }
              }
            }
          },
          {
            "id": "waiting-swatch",
            "component": "ColorSwatch",
            "color": "peacock",
            "shape": "dot"
          },
          {
            "id": "waiting-when",
            "component": "Text",
            "text": {
              "path": "when"
            },
            "variant": "labelLarge"
          },
          {
            "id": "waiting-body",
            "component": "Stack",
            "children": [
              "waiting-summary",
              "waiting-note"
            ],
            "gap": "none"
          },
          {
            "id": "waiting-summary",
            "component": "Text",
            "text": {
              "path": "summary"
            },
            "maxLines": 1
          },
          {
            "id": "waiting-note",
            "component": "Text",
            "text": {
              "path": "note"
            },
            "variant": "bodySmall",
            "color": "onSurfaceVariant",
            "maxLines": 1
          },
          {
            "id": "divider",
            "component": "Divider"
          },
          {
            "id": "clash-label",
            "component": "Stack",
            "children": [
              "clash-title"
            ],
            "padding": "sm"
          },
          {
            "id": "clash-title",
            "component": "Text",
            "text": "Double-booked today",
            "variant": "titleSmall",
            "color": "primary"
          },
          {
