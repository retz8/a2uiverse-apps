{
  "name": "event-create",
  "intent": "Put half an hour with the design team on Thursday afternoon.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "propose-event",
        "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/calendar/calendar-catalog/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "propose-event",
        "path": "/",
        "value": {
          "summary": "Design team sync",
          "when": "Thursday, 14:00 – 14:30",
          "guests": "Alex Bergman, Mei Silva"
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "propose-event",
        "components": [
          {
            "id": "root",
            "component": "Surface",
            "child": "body",
            "container": "high",
            "shape": "extraLarge",
            "padding": "large",
            "elevation": "level2"
          },
          {
            "id": "body",
            "component": "Stack",
            "children": [
              "title-field",
              "details",
              "actions"
            ],
            "gap": "md"
          },
          {
            "id": "title-field",
            "component": "TextField",
            "label": "Title",
            "value": {
              "path": "/summary"
            },
            "placeholder": "Add title",
            "variant": "plain",
            "size": "large"
          },
          {
            "id": "details",
            "component": "List",
            "children": [
              "when-row",
              "guests-row"
            ]
          },
          {
            "id": "when-row",
            "component": "ListItem",
            "headline": "when",
            "leading": [
              "when-icon"
            ]
          },
          {
            "id": "when-icon",
            "component": "Icon",
            "name": "schedule"
          },
          {
            "id": "when",
            "component": "Text",
            "text": {
              "path": "/when"
            }
          },
          {
            "id": "guests-row",
            "component": "ListItem",
            "headline": "guests",
            "leading": [
              "guests-icon"
            ]
          },
          {
            "id": "guests-icon",
            "component": "Icon",
            "name": "group"
          },
          {
            "id": "guests",
            "component": "Text",
            "text": {
              "path": "/guests"
            }
          },
          {
            "id": "actions",
            "component": "Stack",
            "children": [
              "cancel",
              "create"
            ],
            "direction": "horizontal",
            "justify": "end",
            "gap": "sm"
          },
          {
            "id": "cancel",
            "component": "Button",
            "label": "Discard",
            "variant": "text",
            "action": {
              "event": {
                "name": "cancel-event",
                "context": {
                  "proposalId": "propose-event"
                }
              }
            }
          },
          {
            "id": "create",
            "component": "Button",
            "label": "Create event",
            "action": {
              "event": {
                "name": "confirm-event",
                "context": {
                  "proposalId": "propose-event"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
