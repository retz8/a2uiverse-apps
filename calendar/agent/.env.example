# Live agent (llm_agent) configuration. Copy to agent/.env and fill in.

# Gemini model (ADK-native). gemini-3.5-flash works as a cheaper fallback; when a defect
# looks like a model ceiling rather than a prompt problem, swap up to
# gemini-3.1-pro-preview through this same knob.
MODEL_NAME=gemini-3.7-flash

# Google AI Studio API key — ADK reads this to auth Gemini.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The GCP project enrolled in the Workspace Developer Preview, sent as the
# X-Goog-User-Project header on every Calendar MCP call.
GOOGLE_CLOUD_PROJECT=a2uiverse-506907

# The seeded demo calendar the agent reads (task-2.7 decision 4). NOT `primary`: the agent
# never reads the developer's own calendar, because a recording bound for a public repo must
# not be able to contain real appointments. Create it and populate it with
# `scripts/seed_calendar.py` — see README.md, "The demo calendar". Startup fails without it.
CALENDAR_ID=

# NOTE: there is no Google token here, deliberately. The agent reads Application Default
# Credentials and lets the library refresh them, so it never holds a secret and never
# expires mid-run. Mint them once — see README.md, "Setting up the Calendar credential".

