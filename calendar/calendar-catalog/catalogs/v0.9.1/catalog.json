{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retz8/a2uiverse-apps/blob/main/calendar/calendar-catalog/catalogs/v0.9.1/catalog.json",
  "title": "Google Calendar Catalog",
  "description": "The Google Calendar app catalog: Calendar's own components in Material 3's design language — surfaces, lists of rows, event colours, guests with their responses, buttons, fields — with the basic catalog's functions.",
  "catalogId": "https://github.com/retz8/a2uiverse-apps/blob/main/calendar/calendar-catalog/catalogs/v0.9.1/catalog.json",
  "components": {
    "Surface": {
      "type": "object",
      "description": "A surface holding one child: the ground a view is drawn on. `container` picks the tier — `lowest` is the brightest in the light theme, the usual surface for an agenda; `low` is a tinted ground; `high` is the tinted card an event's details open on; `highest` is for emphasised areas such as a response bar.",
      "properties": {
        "component": {
          "const": "Surface"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The id of the one component this surface holds, usually a Stack."
        },
        "container": {
          "type": "string",
          "enum": ["lowest", "low", "default", "high", "highest"],
          "description": "The surface tier.",
          "default": "lowest"
        },
        "shape": {
          "type": "string",
          "enum": ["none", "small", "medium", "large", "extraLarge"],
          "description": "The corner rounding: 0, 8, 12, 16 or 28 px.",
          "default": "large"
        },
        "padding": {
          "type": "string",
          "enum": ["none", "small", "medium", "large"],
          "description": "The space inside the edge: 0, 8, 16 or 24 px.",
          "default": "medium"
        },
        "elevation": {
          "type": "string",
          "enum": ["level0", "level1", "level2", "level3"],
          "description": "The shadow under the surface; `level0` is flat.",
          "default": "level0"
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "description": "A card holding one child: a self-contained block such as an event to confirm or a question to answer. `outlined` is a bordered card, `elevated` a raised one, `filled` a tinted one.",
      "properties": {
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The id of the one component this card holds, usually a Stack."
        },
        "variant": {
          "type": "string",
          "enum": ["elevated", "filled", "outlined"],
          "description": "The card style.",
          "default": "outlined"
        }
      },
      "required": ["component", "child"],
      "unevaluatedProperties": false
    },
    "Stack": {
      "type": "object",
      "description": "Lays its children out in a column or a row, with a gap between them.",
      "properties": {
        "component": {
          "const": "Stack"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The components laid out, in order: a static list of ids, or a template over a bound array."
        },
        "direction": {
          "type": "string",
          "enum": ["vertical", "horizontal"],
          "description": "A column or a row.",
          "default": "vertical"
        },
        "gap": {
          "type": "string",
          "enum": ["none", "xs", "sm", "md", "lg", "xl"],
          "description": "The space between children: 0, 4, 8, 12, 16 or 24 px.",
          "default": "sm"
        },
        "align": {
          "type": "string",
          "enum": ["stretch", "start", "center", "end", "baseline"],
          "description": "Alignment across the direction. Defaults to `stretch` in a column and `center` in a row."
        },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "spaceBetween"],
          "description": "Distribution along the direction; `spaceBetween` pushes the first and last children to the ends.",
          "default": "start"
        },
        "wrap": {
          "type": "boolean",
          "description": "Whether a row wraps onto further lines when it runs out of width.",
          "default": false
        },
        "padding": {
          "type": "string",
          "enum": ["none", "sm", "md", "lg"],
          "description": "The space inside the stack's edge: none; 8 px above and below with 16 px at the sides, the inset of a list row's content; 16 px; or 24 px.",
          "default": "none"
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "A hairline separating two sections.",
      "properties": {
        "component": {
          "const": "Divider"
        },
        "inset": {
          "type": "string",
          "enum": ["none", "start", "middle"],
          "description": "Full width, inset 16 px at the start, or inset 16 px on both sides.",
          "default": "none"
        }
      },
      "required": ["component"],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "description": "A run of text in a type role. `titleLarge` is a view's or an event's title; `titleSmall` a section heading; `bodyMedium` is the default for content; `bodySmall` and the `label` roles are for times, counts and captions.",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The text to show."
        },
        "variant": {
          "type": "string",
          "enum": [
            "displaySmall",
            "headlineLarge",
            "headlineMedium",
            "headlineSmall",
            "titleLarge",
            "titleMedium",
            "titleSmall",
            "bodyLarge",
            "bodyMedium",
            "bodySmall",
            "labelLarge",
            "labelMedium",
            "labelSmall"
          ],
          "description": "The type role: size, line height and weight together.",
          "default": "bodyMedium"
        },
        "weight": {
          "type": "string",
          "enum": ["regular", "medium", "bold"],
          "description": "Overrides the role's weight; `bold` marks something unread or needing attention."
        },
        "color": {
          "type": "string",
          "enum": ["onSurface", "onSurfaceVariant", "primary", "error", "inherit"],
          "description": "The colour role: `onSurface` for content, `onSurfaceVariant` for secondary text, `primary` for a link-like accent, `error` for a failure.",
          "default": "onSurface"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "description": "Clamps the text to this many lines, ending in an ellipsis; the full text shows on hover."
        }
      },
      "required": ["component", "text"],
      "unevaluatedProperties": false
    },
    "Icon": {
      "type": "object",
      "description": "A system glyph. Use one where it tells rows apart or names a field, not as decoration.",
      "properties": {
        "component": {
          "const": "Icon"
        },
        "name": {
          "type": "string",
          "enum": [
            "add",
            "arrow_back",
            "calendar_today",
            "cancel",
            "check",
            "check_circle",
            "chevron_left",
            "chevron_right",
            "close",
            "content_copy",
            "edit",
            "error",
            "event",
            "event_available",
            "event_busy",
            "expand_less",
            "expand_more",
            "group",
            "help",
            "info",
            "location_on",
            "lock",
            "mail",
            "meeting_room",
            "more_vert",
            "notes",
            "notifications",
            "person",
            "refresh",
            "repeat",
            "schedule",
            "search",
            "today",
            "videocam",
            "warning"
          ],
          "description": "The glyph."
        },
        "filled": {
          "type": "boolean",
          "description": "Whether the glyph is drawn filled rather than outlined.",
          "default": false
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "The glyph size: 18, 20 or 24 px.",
          "default": "large"
        },
        "color": {
          "type": "string",
          "enum": ["onSurface", "onSurfaceVariant", "primary", "error", "inherit"],
          "description": "The colour role.",
          "default": "onSurfaceVariant"
        }
      },
      "required": ["component", "name"],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "description": "A labelled button carrying an action. `filled` is the one most important action on a surface, such as saving; `tonal` a selected or secondary one, such as the response already given; `outlined` and `text` the rest.",
      "properties": {
        "component": {
          "const": "Button"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The button's label: names the outcome, e.g. \"Create event\"."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the button is pressed."
        },
        "variant": {
          "type": "string",
          "enum": ["filled", "tonal", "outlined", "text", "elevated"],
          "description": "The button's emphasis.",
          "default": "filled"
        },
        "icon": {
          "type": "string",
          "enum": [
            "add",
            "arrow_back",
            "calendar_today",
            "cancel",
            "check",
            "check_circle",
            "chevron_left",
            "chevron_right",
            "close",
            "content_copy",
            "edit",
            "error",
            "event",
            "event_available",
            "event_busy",
            "expand_less",
            "expand_more",
            "group",
            "help",
            "info",
            "location_on",
            "lock",
            "mail",
            "meeting_room",
            "more_vert",
            "notes",
            "notifications",
            "person",
            "refresh",
            "repeat",
            "schedule",
            "search",
            "today",
            "videocam",
            "warning"
          ],
          "description": "A glyph before the label."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the button is disabled."
        }
      },
      "required": ["component", "label", "action"],
      "unevaluatedProperties": false
    },
    "IconButton": {
      "type": "object",
      "description": "A round button showing only a glyph, for compact actions in a row or a toolbar. With `selected` bound it is a toggle: pressing writes the new state back, then performs the action.",
      "properties": {
        "component": {
          "const": "IconButton"
        },
        "icon": {
          "type": "string",
          "enum": [
            "add",
            "arrow_back",
            "calendar_today",
            "cancel",
            "check",
            "check_circle",
            "chevron_left",
            "chevron_right",
            "close",
            "content_copy",
            "edit",
            "error",
            "event",
            "event_available",
            "event_busy",
            "expand_less",
            "expand_more",
            "group",
            "help",
            "info",
            "location_on",
            "lock",
            "mail",
            "meeting_room",
            "more_vert",
            "notes",
            "notifications",
            "person",
            "refresh",
            "repeat",
            "schedule",
            "search",
            "today",
            "videocam",
            "warning"
          ],
          "description": "The glyph; drawn filled while selected."
        },
        "label": {
          "type": "string",
          "description": "What the button does, for assistive technology and the hover tooltip."
        },
        "variant": {
          "type": "string",
          "enum": ["standard", "filled", "tonal", "outlined"],
          "description": "The button's container.",
          "default": "standard"
        },
        "selected": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "The toggle state, two-way bound."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the button is pressed."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the button is disabled."
        }
      },
      "required": ["component", "icon", "label"],
      "unevaluatedProperties": false
    },
    "Chip": {
      "type": "object",
      "description": "A compact control. `filter` chips toggle a filter or an option on and off, showing a check while selected; `input` chips stand for an entered value; `assist` and `suggestion` chips perform an action. With `selected` bound, pressing writes the new state back, then performs the action.",
      "properties": {
        "component": {
          "const": "Chip"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The chip's label."
        },
        "variant": {
          "type": "string",
          "enum": ["assist", "filter", "input", "suggestion"],
          "description": "The chip's kind.",
          "default": "assist"
        },
        "icon": {
          "type": "string",
          "enum": [
            "add",
            "arrow_back",
            "calendar_today",
            "cancel",
            "check",
            "check_circle",
            "chevron_left",
            "chevron_right",
            "close",
            "content_copy",
            "edit",
            "error",
            "event",
            "event_available",
            "event_busy",
            "expand_less",
            "expand_more",
            "group",
            "help",
            "info",
            "location_on",
            "lock",
            "mail",
            "meeting_room",
            "more_vert",
            "notes",
            "notifications",
            "person",
            "refresh",
            "repeat",
            "schedule",
            "search",
            "today",
            "videocam",
            "warning"
          ],
          "description": "A glyph before the label."
        },
        "selected": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether a filter or input chip is selected, two-way bound."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the chip is pressed."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the chip is disabled."
        }
      },
      "required": ["component", "label"],
      "unevaluatedProperties": false
    },
    "Avatar": {
      "type": "object",
      "description": "A person's initial in a filled circle, with an optional badge for their response to an invitation: a check for yes, a cross for no, a question mark while awaited.",
      "properties": {
        "component": {
          "const": "Avatar"
        },
        "name": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The person's name or address; also the avatar's accessible name."
        },
        "status": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The person's response: `accepted`, `declined`, `tentative` or `needsAction` as the calendar spells it, or the words a person reads (\"Accepted\", \"Declined\", \"No answer yet\"). Anything not a yes or a no reads as awaited."
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "description": "The diameter: 24, 32 or 40 px.",
          "default": "large"
        }
      },
      "required": ["component", "name"],
      "unevaluatedProperties": false
    },
    "ColorSwatch": {
      "type": "object",
      "description": "An event's colour: a small rounded square beside its title, or a dot in a row.",
      "properties": {
        "component": {
          "const": "ColorSwatch"
        },
        "color": {
          "type": "string",
          "enum": [
            "lavender",
            "sage",
            "grape",
            "flamingo",
            "banana",
            "tangerine",
            "peacock",
            "graphite",
            "blueberry",
            "basil",
            "tomato"
          ],
          "description": "The event colour, by the name the calendar gives it."
        },
        "shape": {
          "type": "string",
          "enum": ["square", "dot"],
          "description": "A rounded square or a dot.",
          "default": "square"
        }
      },
      "required": ["component", "color"],
      "unevaluatedProperties": false
    },
    "List": {
      "type": "object",
      "description": "A list of ListItem rows, e.g. the events of a day or the guests of an event.",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "The rows: ListItem ids, or a template over a bound array."
        },
        "dividers": {
          "type": "boolean",
          "description": "Whether a hairline separates the rows.",
          "default": false
        },
        "layout": {
          "type": "string",
          "enum": ["stacked", "inline"],
          "description": "How rows arrange their parts. `inline` puts each row's headline, supporting content and meta on one line when the list is wide, as a schedule's rows do; `stacked` always sets the supporting content beneath the headline.",
          "default": "stacked"
        }
      },
      "required": ["component", "children"],
      "unevaluatedProperties": false
    },
    "ListItem": {
      "type": "object",
      "description": "One row of a List, e.g. an event, a guest, or one of an event's details beside its glyph. `headline` leads the row, with `meta` at the far end (such as a time) and `supporting` content after the headline (such as a subject and a snippet), beneath it or on the same line as the List's `layout` sets. `leading` and `trailing` hold small visuals or controls. With an action the whole row is pressable and lifts on hover, so a row with an action holds no Button.",
      "properties": {
        "component": {
          "const": "ListItem"
        },
        "headline": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "The row's first line, usually a Text: an event's time or title, a guest's name."
        },
        "supporting": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "What sits under or after the headline, usually a Text or a Stack of Text: an event's description, a guest's role."
        },
        "meta": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId",
          "description": "A short value at the end of the first line, usually a Text: a time or a count."
        },
        "leading": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "Visuals before the content, in order: a ColorSwatch, an Icon, an Avatar, a Checkbox."
        },
        "trailing": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
          "description": "Controls or values after the content, in order: IconButtons, Chips."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed when the row is pressed."
        },
        "selected": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the row is selected, drawn on a tinted background."
        }
      },
      "required": ["component", "headline"],
      "unevaluatedProperties": false
    },
    "TextField": {
      "type": "object",
      "description": "A text input with a label, two-way bound: typing writes the value back. `outlined` and `filled` are form fields with the label on the field's edge; `plain` sets the label before the value on one underlined line. A `plain` field of `large` size is an event's title, and a `plain` multi-line field a description: their labels are announced, not drawn.",
      "properties": {
        "component": {
          "const": "TextField"
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The field's label."
        },
        "value": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The field's value, two-way bound."
        },
        "placeholder": {
          "type": "string",
          "description": "Text shown while the field is empty."
        },
        "variant": {
          "type": "string",
          "enum": ["outlined", "filled", "plain"],
          "description": "The field's style.",
          "default": "outlined"
        },
        "multiline": {
          "type": "boolean",
          "description": "Whether the field takes several lines of text.",
          "default": false
        },
        "size": {
          "type": "string",
          "enum": ["regular", "large"],
          "description": "The text size; `large` is a title's.",
          "default": "regular"
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the field is disabled."
        }
      },
      "required": ["component", "label"],
      "unevaluatedProperties": false
    },
    "Checkbox": {
      "type": "object",
      "description": "A checkbox with an optional label, in the primary colour or a calendar's colour, two-way bound: checking writes the value back, then performs the action.",
      "properties": {
        "component": {
          "const": "Checkbox"
        },
        "value": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the box is checked, two-way bound."
        },
        "label": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
          "description": "The label beside the box; without one, the box stands alone in a row."
        },
        "color": {
          "type": "string",
          "enum": [
            "lavender",
            "sage",
            "grape",
            "flamingo",
            "banana",
            "tangerine",
            "peacock",
            "graphite",
            "blueberry",
            "basil",
            "tomato"
          ],
          "description": "A calendar's colour for the box, by the name the calendar gives it."
        },
        "action": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
          "description": "The action performed after the value changes."
        },
        "disabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the checkbox is disabled."
        }
      },
      "required": ["component", "value"],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "Checks that the value is not null, undefined, or empty.",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "The value to check."
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regex": {
      "type": "object",
      "description": "Checks that the value matches a regular expression string.",
      "properties": {
        "call": {
          "const": "regex"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            },
            "pattern": {
              "type": "string",
              "description": "The regex pattern to match against."
            }
          },
          "required": ["value", "pattern"],
          "unevaluatedProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
